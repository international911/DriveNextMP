<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DriveNext" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Используем шрифт базовой системной темы без отдельной загрузки fontFamily в предпросмотре. -->
        <item name="android:colorAccent">@color/purple</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/white</item>
    </style>
    <style name="Theme.DriveNext.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.DriveNext</item>
    </style>
</resources>
