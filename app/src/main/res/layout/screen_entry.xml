<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/purple"
        android:textSize="34sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/entry_title"
        android:textColor="@color/text"
        android:textSize="24sp"
        android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="@string/entry_description"
        android:textColor="@color/muted" android:textSize="16sp" />
    <Button android:id="@+id/entryLogin" android:layout_width="match_parent" android:layout_height="54dp"
        android:layout_marginTop="48dp" android:text="@string/login" android:textColor="@color/white"
        android:background="@drawable/button_background" />
    <Button android:id="@+id/entryRegister" android:layout_width="match_parent" android:layout_height="54dp"
        android:layout_marginTop="12dp" android:text="@string/register" android:textColor="@color/purple"
        android:background="@drawable/outline_button_background" />
</LinearLayout>
