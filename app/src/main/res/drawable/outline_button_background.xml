<?xml version="1.0" encoding="utf-8"?>
<!-- Фигура фона для элемента интерфейса. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Цвет заливки фигуры. -->
    <solid android:color="@color/white" />
    <!-- Линия по краю фигуры. -->
    <stroke android:width="1dp" android:color="@color/field_border" />
    <!-- Закругление углов фигуры. -->
    <corners android:radius="10dp" />
</shape>
